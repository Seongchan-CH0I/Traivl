generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  profileImage  String?
  password      String?
  dnaType       String?  // 예: "힐링 럭셔리러", "본투비 푸드파이터"
  destinationId String?  // 예: "KR_JEJU"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aiUsageLogs   AiUsageLog[]
  dnaStat       UserDnaStat?
  schedules     Schedule[]
}

// 8개 고정 추천 도시
model Destination {
  id           String   @id          // 예: "JP_KYOTO", "KR_JEJU"
  name         String                // 예: "교토, 일본"
  country      String                // 예: "일본", "한국"
  dnaType      String                // 예: "클래식 슬로우뷰어"
  description  String?
  imageUrl     String?
  currency     String?
  language     String?
  voltage      String?
  visaRequired String?
  bestSeason   String[]
  averageCost  Int?
  places       Place[]
}

// 도시별 인기 장소
model Place {
  id            Int         @id @default(autoincrement())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  category      String      // "관광지" | "맛집" | "카페"
  imageUrl      String?
  description   String?
  rating        Float?
  rank          Int         // 순위 (1, 2, 3 ...)
  address       String?     // 상세 주소
  latitude      Float?      // 위도
  longitude     Float?      // 경도
  openingHours  String?     // 영업 시간
  phoneNumber   String?     // 전화번호
  tags          String[]    // 태그 (예: ["#인생샷", "#전통"])
  averagePrice  Int?        // 평균 가격
}

// 사용자 DNA 세부 스탯 (마이페이지 레이더 차트용)
model UserDnaStat {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  culture   Int      @default(50) // 문화
  food      Int      @default(50) // 음식
  budget    Int      @default(50) // 예산
  relax     Int      @default(50) // 휴식
  hotel     Int      @default(50) // 호텔
  activity  Int      @default(50) // 활동

  updatedAt DateTime @updatedAt
}

// AI 기능 활용 기록
model AiUsageLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // 기능 식별자 (예: "menu_analysis", "translation", "voice_translation")
  title     String   // 로그 제목 (예: "메뉴판 분석 기능을 이용하셨습니다.")
  content   String   // 로그 상세 내용
  icon      String?  // 화면에 표시할 아이콘 (예: "🍽️")
  
  createdAt DateTime @default(now())
}

model langchain_pg_collection {
  name                   String?                  @db.VarChar
  cmetadata              Json?                    @db.Json
  uuid                   String                   @id @db.Uuid
  langchain_pg_embedding langchain_pg_embedding[]
}

model langchain_pg_embedding {
  collection_id           String?                  @db.Uuid
  embedding               Unsupported("vector")?
  document                String?                  @db.VarChar
  cmetadata               Json?                    @db.Json
  custom_id               String?                  @db.VarChar
  uuid                    String                   @id @db.Uuid
  langchain_pg_collection langchain_pg_collection? @relation(fields: [collection_id], references: [uuid], onDelete: Cascade, onUpdate: NoAction)
}

model Schedule {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   // 예: "나의 서울 2박 3일 여행"
  city          String   // 예: "서울"
  startDate     DateTime?
  endDate       DateTime?
  itineraryData Json     // AI가 리턴한 일자별 상세 코스 데이터 (JSON)
  isShared      Boolean  @default(false) // 피드 공유 여부
  shareContent  String?  // 피드 공유시 남길 한줄평/소개글
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}