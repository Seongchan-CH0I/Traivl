generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  profileImage  String?
  dnaType       String?  // 예: "힐링 럭셔리러", "본투비 푸드파이터"
  destinationId String?  // 예: "KR_JEJU"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 8개 고정 추천 도시

// 도시별 인기 장소
model Place {
  id            Int         @id @default(autoincrement())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  category      String      // "관광지" | "맛집" | "카페"
  imageUrl      String?
  description   String?
  rating        Float?
  rank          Int         // 순위 (1, 2, 3 ...)
  address       String?     // 상세 주소
  latitude      Float?      // 위도
  longitude     Float?      // 경도
  openingHours  String?     // 영업 시간
  phoneNumber   String?     // 전화번호
  tags          String[]    // 태그 (예: ["#인생샷", "#전통"])
  averagePrice  Int?        // 평균 가격
}