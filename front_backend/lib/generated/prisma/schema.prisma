generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  name          String?
  profileImage  String?
  dnaType       String? // 예: "힐링 럭셔리러", "본투비 푸드파이터"
  destinationId String? // 예: "KR_JEJU"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 8개 고정 추천 도시
model Destination {
  id          String  @id // 예: "JP_KYOTO", "KR_JEJU"
  name        String // 예: "교토, 일본"
  country     String // 예: "일본", "한국"
  dnaType     String // 예: "클래식 슬로우뷰어"
  description String?
  imageUrl    String?
  places      Place[]
}

// 도시별 인기 장소
model Place {
  id            Int         @id @default(autoincrement())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  category      String // "관광지" | "맛집" | "카페"
  imageUrl      String?
  description   String?
  rating        Float?
  rank          Int // 순위 (1, 2, 3 ...)
}
